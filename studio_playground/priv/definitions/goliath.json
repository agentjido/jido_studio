{
  "description": "Coordinates incident intake, evidence collection, review, and audit.",
  "featured": [
    {
      "label": "Request review",
      "signal": "goliath.review.requested",
      "summary": "Build a review packet and wait for a decision."
    },
    {
      "label": "Open incident",
      "signal": "goliath.incident.open",
      "summary": "Write an incident record and return a receipt."
    },
    {
      "label": "Collect evidence",
      "signal": "goliath.evidence.collect",
      "summary": "Queue the request and broadcast it through the audit bus."
    },
    {
      "label": "Collect sources",
      "signal": "goliath.sources.collect",
      "summary": "Read the GitHub pull request and Zendesk ticket in parallel."
    }
  ],
  "flows": {
    "Jido.Lab.Goliath.CollectSources": {
      "components": [
        {
          "handler": null,
          "inputs": [],
          "kind": "parallel",
          "level": 0,
          "name": "provider_reads",
          "needs": [],
          "options": [
            {
              "handler": {
                "kind": "action",
                "target": "Jido.Connect.GitHub.Actions.GetPullRequest"
              },
              "inputs": [
                {
                  "name": "pull_number",
                  "reference": {
                    "component": null,
                    "path": [
                      "pull_number"
                    ],
                    "source": "input"
                  },
                  "value": "input.pull_number"
                },
                {
                  "name": "repo",
                  "reference": {
                    "component": null,
                    "path": [
                      "repo"
                    ],
                    "source": "input"
                  },
                  "value": "input.repo"
                }
              ],
              "name": "pull_request"
            },
            {
              "handler": {
                "kind": "action",
                "target": "Jido.Connect.Zendesk.Actions.GetTicket"
              },
              "inputs": [
                {
                  "name": "ticket_id",
                  "reference": {
                    "component": null,
                    "path": [
                      "ticket_id"
                    ],
                    "source": "input"
                  },
                  "value": "input.ticket_id"
                }
              ],
              "name": "support_ticket"
            }
          ]
        }
      ],
      "name": "goliath_collect_sources",
      "output": [
        {
          "name": "pull_request",
          "reference": {
            "component": "provider_reads",
            "path": [
              0,
              "value"
            ],
            "source": "result"
          },
          "value": "provider_reads.result.0.value"
        },
        {
          "name": "ticket",
          "reference": {
            "component": "provider_reads",
            "path": [
              1,
              "value"
            ],
            "source": "result"
          },
          "value": "provider_reads.result.1.value"
        }
      ]
    },
    "Jido.Lab.Goliath.Review": {
      "components": [
        {
          "handler": {
            "kind": "action",
            "target": "Inline action"
          },
          "inputs": [
            {
              "name": "decisions",
              "reference": {
                "component": "recall_decisions",
                "path": [
                  "recall"
                ],
                "source": "result"
              },
              "value": "recall_decisions.result.recall"
            },
            {
              "name": "id",
              "reference": {
                "component": null,
                "path": [
                  "incident_id"
                ],
                "source": "input"
              },
              "value": "input.incident_id"
            },
            {
              "name": "incident",
              "reference": {
                "component": "load_incident",
                "path": [
                  "result"
                ],
                "source": "result"
              },
              "value": "load_incident.result.result"
            },
            {
              "name": "priority",
              "reference": {
                "component": "priority",
                "path": [],
                "source": "result"
              },
              "value": "priority.result"
            },
            {
              "name": "runbook",
              "reference": {
                "component": "recall_runbook",
                "path": [
                  "recall"
                ],
                "source": "result"
              },
              "value": "recall_runbook.result.recall"
            },
            {
              "name": "sources",
              "reference": {
                "component": "collect_sources",
                "path": [],
                "source": "result"
              },
              "value": "collect_sources.result"
            }
          ],
          "kind": "call",
          "level": 1,
          "name": "assemble_packet",
          "needs": [
            "collect_sources",
            "load_incident",
            "priority",
            "recall_decisions",
            "recall_runbook"
          ],
          "options": []
        },
        {
          "handler": {
            "kind": "flow",
            "target": "Jido.Lab.Goliath.CollectSources"
          },
          "inputs": [
            {
              "name": "pull_number",
              "reference": {
                "component": null,
                "path": [
                  "pull_number"
                ],
                "source": "input"
              },
              "value": "input.pull_number"
            },
            {
              "name": "repo",
              "reference": {
                "component": null,
                "path": [
                  "repo"
                ],
                "source": "input"
              },
              "value": "input.repo"
            },
            {
              "name": "ticket_id",
              "reference": {
                "component": null,
                "path": [
                  "ticket_id"
                ],
                "source": "input"
              },
              "value": "input.ticket_id"
            }
          ],
          "kind": "call",
          "level": 0,
          "name": "collect_sources",
          "needs": [],
          "options": []
        },
        {
          "handler": null,
          "inputs": [],
          "kind": "wait",
          "level": 2,
          "name": "decision",
          "needs": [
            "assemble_packet"
          ],
          "options": [
            {
              "after_ms": null,
              "event": "goliath.review.approved",
              "inputs": [
                {
                  "name": "incident_id",
                  "reference": {
                    "component": "assemble_packet",
                    "path": [
                      "incident_id"
                    ],
                    "source": "result"
                  },
                  "value": "assemble_packet.result.incident_id"
                }
              ],
              "name": "approved"
            },
            {
              "after_ms": null,
              "event": "goliath.review.rejected",
              "inputs": [
                {
                  "name": "incident_id",
                  "reference": {
                    "component": "assemble_packet",
                    "path": [
                      "incident_id"
                    ],
                    "source": "result"
                  },
                  "value": "assemble_packet.result.incident_id"
                }
              ],
              "name": "rejected"
            },
            {
              "after_ms": 900000,
              "event": null,
              "inputs": [],
              "name": "expired"
            }
          ]
        },
        {
          "handler": {
            "kind": "action",
            "target": "Jido.Lab.Goliath.Incidents.Jido.GetIncident"
          },
          "inputs": [
            {
              "name": "id",
              "reference": {
                "component": null,
                "path": [
                  "incident_id"
                ],
                "source": "input"
              },
              "value": "input.incident_id"
            }
          ],
          "kind": "call",
          "level": 0,
          "name": "load_incident",
          "needs": [],
          "options": []
        },
        {
          "handler": null,
          "inputs": [],
          "kind": "choice",
          "level": 0,
          "name": "priority",
          "needs": [],
          "options": [
            {
              "condition": "input.severity >= 4",
              "handler": {
                "kind": "action",
                "target": "Jido.Lab.Goliath.ReviewPriority"
              },
              "inputs": [
                {
                  "name": "queue",
                  "value": "\"urgent\""
                }
              ],
              "name": "urgent"
            },
            {
              "condition": "input.severity >= 2",
              "handler": {
                "kind": "action",
                "target": "Jido.Lab.Goliath.ReviewPriority"
              },
              "inputs": [
                {
                  "name": "queue",
                  "value": "\"expedited\""
                }
              ],
              "name": "expedited"
            },
            {
              "condition": null,
              "handler": {
                "kind": "action",
                "target": "Jido.Lab.Goliath.ReviewPriority"
              },
              "inputs": [
                {
                  "name": "queue",
                  "value": "\"standard\""
                }
              ],
              "name": "otherwise"
            }
          ]
        },
        {
          "handler": {
            "kind": "action",
            "target": "Jido.Memory.Actions.RecallGranted"
          },
          "inputs": [
            {
              "name": "grant",
              "value": ":prior_decisions"
            },
            {
              "name": "where",
              "value": "{incident_id: input.incident_id}"
            }
          ],
          "kind": "call",
          "level": 0,
          "name": "recall_decisions",
          "needs": [],
          "options": []
        },
        {
          "handler": {
            "kind": "action",
            "target": "Jido.Memory.Actions.RecallGranted"
          },
          "inputs": [
            {
              "name": "grant",
              "value": ":related_runbooks"
            },
            {
              "name": "where",
              "value": "{repo: input.repo}"
            }
          ],
          "kind": "call",
          "level": 0,
          "name": "recall_runbook",
          "needs": [],
          "options": []
        }
      ],
      "name": "goliath_review",
      "output": [
        {
          "name": "decision",
          "reference": {
            "component": "decision",
            "path": [
              "selected"
            ],
            "source": "result"
          },
          "value": "decision.result.selected"
        },
        {
          "name": "summary",
          "reference": {
            "component": "assemble_packet",
            "path": [],
            "source": "result"
          },
          "value": "assemble_packet.result"
        }
      ]
    }
  },
